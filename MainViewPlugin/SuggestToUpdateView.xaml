<Window x:Class="Mcv.MainViewPlugin.SuggestToUpdateView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mcv.MainViewPlugin"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:SuggestToUpdateViewModel, IsDesignTimeCreatable=True}"
        Title="SuggestToUpdateView" Height="465" Width="740">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="51*"/>
            <ColumnDefinition Width="23*"/>
        </Grid.ColumnDefinitions>
        <Grid Margin="137,29,125,330" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label x:Name="labelCurrentVersion" Content="{Binding CurrentVersion}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" />
            <Label x:Name="labelLatestVersion" Content="{Binding LatestVersion}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2"/>
            <Label x:Name="labelArrow" Content="→" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />
        </Grid>

        <Button x:Name="btnOk" Content="はい" Command="{Binding OkCommand}" IsEnabled="{Binding IsOkEnabled}" HorizontalAlignment="Left" Margin="215,404,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnCancel" Content="いいえ" Command="{Binding CancelCommand}" IsEnabled="{Binding IsCancelEnabled}" HorizontalAlignment="Left" Margin="316,404,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="label" Text="{Binding Log,UpdateSourceTrigger=PropertyChanged}" Margin="80,119,102,150" VerticalScrollBarVisibility="Visible" Grid.ColumnSpan="2" />
        <Label x:Name="labelDownloadedSize" Content="{Binding TotalBytesDownloaded}" HorizontalAlignment="Left" Margin="170,314,0,0" VerticalAlignment="Top" />
        <Label x:Name="labelTotalSize" Content="{Binding TotalFileSize}" HorizontalAlignment="Left" Margin="269,314,0,0" VerticalAlignment="Top" />

    </Grid>
</Window>
